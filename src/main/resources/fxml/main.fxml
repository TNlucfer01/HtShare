<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  HtShare main window.
  Top bar · two-column body (controls | connect panel) · status bar.
  Styling: css/base.css + css/{dark,light}-theme.css
-->
<VBox fx:id="rootContainer" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.htshare.ui.MainController" styleClass="app">

	<!-- Top bar -->
	<HBox styleClass="topbar">
		<Label text="HtShare" styleClass="brand" />
		<Label text="Local file sharing" styleClass="brand-sub" />
		<Region HBox.hgrow="ALWAYS" />
		<HBox fx:id="serverStatePill" styleClass="pill">
			<Region styleClass="dot" />
			<Label fx:id="serverStateLabel" text="Idle" />
		</HBox>
		<ToggleButton fx:id="themeToggle" onAction="#handleThemeToggle" styleClass="icon-button"
			mnemonicParsing="false">
			<graphic>
				<FontIcon fx:id="themeIcon" iconLiteral="fth-sun" iconSize="16" />
			</graphic>
			<tooltip>
				<Tooltip text="Switch theme" />
			</tooltip>
		</ToggleButton>
	</HBox>

	<!-- Body -->
	<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
		<VBox alignment="TOP_CENTER">
			<HBox styleClass="body" maxWidth="1080">

				<!-- Left: controls -->
				<VBox styleClass="column" HBox.hgrow="ALWAYS" minWidth="360">

					<!-- Folder -->
					<VBox styleClass="card">
						<VBox spacing="3">
							<Label text="Shared folder" styleClass="card-title" />
							<Label text="Everything inside this folder is visible to connected devices."
								styleClass="hint" wrapText="true" />
						</VBox>
						<HBox spacing="8" alignment="CENTER_LEFT">
							<HBox styleClass="field" HBox.hgrow="ALWAYS">
								<FontIcon iconLiteral="fth-folder" iconSize="14" />
								<Label fx:id="folderPathLabel" text="No folder selected"
									styleClass="folder-path, folder-empty" textOverrun="LEADING_ELLIPSIS"
									maxWidth="Infinity" HBox.hgrow="ALWAYS" />
							</HBox>
							<Button fx:id="selectFolderButton" text="Choose…" onAction="#handleSelectFolder"
								minWidth="90" />
						</HBox>
					</VBox>

					<!-- Options -->
					<VBox styleClass="card">
						<Label text="Options" styleClass="card-title" />
						<HBox styleClass="option">
							<VBox spacing="2" HBox.hgrow="ALWAYS">
								<Label text="HTTPS" styleClass="option-title" />
								<Label text="Encrypted. Phones will show a one-time certificate warning."
									styleClass="hint" wrapText="true" />
							</VBox>
							<CheckBox fx:id="httpsCheck" styleClass="switch" selected="true"
								mnemonicParsing="false" />
						</HBox>
						<Region styleClass="divider" />
						<HBox styleClass="option">
							<VBox spacing="2" HBox.hgrow="ALWAYS">
								<Label text="Auto-stop" styleClass="option-title" />
								<Label text="Stop sharing after 5 minutes with no activity."
									styleClass="hint" wrapText="true" />
							</VBox>
							<CheckBox fx:id="autoShutdownCheck" styleClass="switch" selected="true"
								mnemonicParsing="false" />
						</HBox>
					</VBox>

					<!-- Start / stop -->
					<HBox spacing="10" alignment="CENTER_LEFT">
						<Button fx:id="startServerButton" text="Start sharing" onAction="#handleStartServer"
							styleClass="button-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS" disable="true" />
						<Button fx:id="stopServerButton" text="Stop sharing" onAction="#handleStopServer"
							styleClass="button-danger" maxWidth="Infinity" HBox.hgrow="ALWAYS" visible="false" />
						<ProgressIndicator fx:id="serverProgress" prefWidth="22" prefHeight="22"
							visible="false" />
					</HBox>

					<!-- Live stats -->
					<HBox fx:id="statsSection" styleClass="card" visible="false">
						<VBox styleClass="stat, stat-first" HBox.hgrow="ALWAYS">
							<Label text="Requests" styleClass="stat-label" />
							<Label fx:id="requestsLabel" text="0" styleClass="stat-value" />
						</VBox>
						<VBox styleClass="stat" HBox.hgrow="ALWAYS">
							<Label text="Downloads" styleClass="stat-label" />
							<Label fx:id="downloadsLabel" text="0" styleClass="stat-value" />
						</VBox>
						<VBox styleClass="stat" HBox.hgrow="ALWAYS">
							<Label text="Connected" styleClass="stat-label" />
							<Label fx:id="activeConnectionsLabel" text="0" styleClass="stat-value" />
						</VBox>
						<VBox styleClass="stat" HBox.hgrow="ALWAYS">
							<Label text="Auto-stop in" styleClass="stat-label" />
							<Label fx:id="timeRemainingLabel" text="--" styleClass="stat-value" />
						</VBox>
					</HBox>

					<Label fx:id="portInfoLabel" styleClass="hint" wrapText="true" visible="false" />
				</VBox>

				<!-- Right: connect panel -->
				<VBox styleClass="card" minWidth="300" prefWidth="320" maxWidth="320">
					<VBox spacing="3">
						<Label text="Connect a device" styleClass="card-title" />
						<Label text="Scan with your phone's camera. Both devices must be on the same network."
							styleClass="hint" wrapText="true" />
					</VBox>

					<HBox alignment="CENTER">
						<StackPane fx:id="qrFrame" styleClass="qr-frame">
							<VBox fx:id="qrPlaceholder" styleClass="qr-placeholder">
								<FontIcon iconLiteral="fth-smartphone" iconSize="26" />
								<Label text="Start sharing to get a QR code" wrapText="true" />
							</VBox>
							<ImageView fx:id="qrCodeImageView" fitWidth="232" fitHeight="232"
								preserveRatio="true" smooth="false" visible="false" />
						</StackPane>
					</HBox>

					<HBox fx:id="urlContainer" styleClass="field, url-box" visible="false">
						<Label fx:id="serverUrlLabel" styleClass="url" maxWidth="Infinity"
							HBox.hgrow="ALWAYS" />
						<Button fx:id="copyUrlButton" onAction="#handleCopyUrl" styleClass="icon-button">
							<graphic>
								<FontIcon iconLiteral="fth-copy" iconSize="14" />
							</graphic>
							<tooltip>
								<Tooltip text="Copy link" />
							</tooltip>
						</Button>
					</HBox>
				</VBox>
			</HBox>
		</VBox>
	</ScrollPane>

	<!-- Status bar -->
	<HBox styleClass="statusbar">
		<Label fx:id="statusLabel" text="Ready" styleClass="status-info" maxWidth="Infinity"
			HBox.hgrow="ALWAYS" />
		<FontIcon iconLiteral="fth-wifi" iconSize="12" />
		<Label fx:id="networkStatusLabel" text="Checking network…" styleClass="network-success" />
		<Button fx:id="refreshNetworkButton" onAction="#handleRefreshNetwork" styleClass="icon-button">
			<graphic>
				<FontIcon iconLiteral="fth-refresh-cw" iconSize="12" />
			</graphic>
			<tooltip>
				<Tooltip text="Check network again" />
			</tooltip>
		</Button>
		<Region styleClass="bar-sep" />
		<Hyperlink fx:id="githubLink" text="GitHub" onAction="#handleGithubLink" />
	</HBox>
</VBox>
