<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.htshare.HtShare</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>HtShare</name>
  <summary>Share a folder to any phone on your network</summary>
  <description>
    <p>
      Pick a folder, press Start sharing and scan the QR code. Any phone or laptop on the same
      network can browse and download the files in its browser, with no app to install.
    </p>
    <ul>
      <li>QR code to connect</li>
      <li>Fast asynchronous transfers to many devices at once</li>
      <li>Resumable downloads and video seeking</li>
      <li>Live transfers panel with progress and speed for each device</li>
      <li>HTTPS with a self-signed certificate, or plain HTTP</li>
      <li>Stops sharing by itself after 5 idle minutes</li>
      <li>Dark and light themes</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.htshare.HtShare.desktop</launchable>
  <screenshots>
